<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.solvd.library.mapper.AuthorMapper">

    <resultMap id="AuthorResultMap" type="com.solvd.library.domain.Author" autoMapping="false">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
    </resultMap>

    <insert id="create" parameterType="com.solvd.library.domain.Author" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO author (`name`)
        VALUES (#{name})
    </insert>

    <select id="findById" parameterType="long" resultMap="AuthorResultMap">
        SELECT id, name
        FROM author
        WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="AuthorResultMap">
        SELECT id, name
        FROM author
    </select>

    <update id="update" parameterType="com.solvd.library.domain.Author">
        UPDATE author
        SET name=#{name}
        WHERE id=#{id}
    </update>

    <delete id="delete" parameterType="long">
        DELETE FROM author WHERE id=#{id}
    </delete>

</mapper>